{
  "agentMode": "accept-edits",
  "artifactReviewPolicy": "always-proceed",
  "colorScheme": "dark",
  "model": "Gemini 3.8 Flash (High)",
  "permissions": {
    "allow": [
      "command(ls)",
      "read_url(antigravity.google)",
      "command(cat)",
      "command(~/.gemini/antigravity-cli/bin/agy)",
      "command(/opt/homebrew/bin/agy)",
      "command(git)",
      "command(cargo)",
      "command(pnpm)",
      "command(npm)",
      "command(bun)",
      "command(yarn)",
      "command(gradle)",
      "command(./gradlew)",
      "command(just)",
      "command(python3)",
      "command(uv)",
      "command(go)",
      "command(docker)",
      "command(grep)",
      "command(rg)",
      "command(find)",
      "command(jq)"
    ]
  },
  "runningLightSpeed": "fast",
  "statusLine": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/statusline.sh",
    "enabled": true,
    "stack_with_default": true
  },
  "toolPermission": "always-proceed",
  "verbosity": "high"
}
